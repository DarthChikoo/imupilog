define INS_AUX_INSTANCES 3

# Reassign AUX5 and AUX6 from PWM to chip select
undef PD13 PD14
PD13 BMI160_LEFT_CS CS
PD14 BMI160_RIGHT_CS CS

# Four BMI160 devices on SPI4
SPIDEV bmi160_firewall SPI4 DEVID6 MPU_EXT_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmi160_tail SPI4 DEVID7 BARO_EXT_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmi160_left SPI4 DEVID8 BMI160_LEFT_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmi160_right SPI4 DEVID9 BMI160_RIGHT_CS MODE3 1*MHZ 10*MHZ
